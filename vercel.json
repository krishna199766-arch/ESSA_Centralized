{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-ME.onrender.com/api/:path*" },
    { "source": "/pos", "destination": "https://REPLACE-ME.onrender.com/pos" },
    { "source": "/pos/:path*", "destination": "https://REPLACE-ME.onrender.com/pos/:path*" },
    { "source": "/m", "destination": "https://REPLACE-ME.onrender.com/m" },
    { "source": "/m/:path*", "destination": "https://REPLACE-ME.onrender.com/m/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
